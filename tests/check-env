#!/usr/bin/env bash
# Runs in place of the publisher. A plain shebang keeps the env that entry.sh passed.
# s6 exits the container with this script's exit code.

failed=0

check() {
	if [[ "${2}" == "${3}" ]]; then
		echo "ok: ${1}"
		return
	fi
	echo "not ok: ${1}: expected '${3}', got '${2}'"
	failed=1
}

for service in dbus avahi-daemon certs-watch; do
	check "${service} is up" "$(s6-svstat -u "/run/service/${service}")" true
done

check "generated API_HOST" "${API_HOST:-}" api.example.test
check "input MDNS_TLD" "${MDNS_TLD:-}" example.test
check "input MDNS_SUBDOMAINS" "${MDNS_SUBDOMAINS:-}" api

exit "${failed}"
